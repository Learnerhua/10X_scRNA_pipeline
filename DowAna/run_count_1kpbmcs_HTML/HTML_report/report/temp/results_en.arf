file =  <url = IDBiotech_result/run_count_1kpbmcs/04.sSample/sample_run_count_1kpbmcs_heatmapClusters.png; label = "run_count_1kpbmcs">
size = <width = 1000>
desc="The abscissa represents different cell groups; The ordinate is Marker gene; Yellow represents high expression and purple represents low expression."

@figure
number = 11
title = "Bubble heatmap of Marker gene "
file =  <url = IDBiotech_result/run_count_1kpbmcs/04.sSample/sample_run_count_1kpbmcs_dotplotClusters.png; label = "run_count_1kpbmcs">
size = <width = 1200>
desc="The abscissa is Marker gene and the ordinate is different cell group. The color ranges from light to dark, darker color represent higher expression level. Larger bubble indicates a higher percentage of cells expressing the gene in the cell group."

@figure

%result
@title
Sequencing statistics
@paragraph

@subtitle
number = 1
Quality Control of Sequencing Data
@paragraph
Quality control was processed on Read1 and Read2, Read1 contains 16bp cell barcode and 12bp UMI sequence, and Read2 is cDNA sequence. The Cell Ranger (v10.0.0) tool was used to filter Read1 and Read2 for quality control. The filtering standards are detailed in the information analysis process - Off-board Data Quality Control. The statistical results of quality control are shown in Table 2.
@table
number = 2
title = "Quality control results of sequencing data"
file = <url = IDBiotech_result/QC.xls>
format = <field = 1; type = string; align =centre; desc = "Sample">
format = <field = 2; type = string; align =centre; desc = "Sample">
format = <field = 3; type = string; align =centre; desc = "Sample">
format = <field = 4; type = string; align =centre; desc = "Sample">
format = <field = 5; type = string; align =centre; desc = "Sample">
format = <field = 6; type = string; align =centre; desc = "Sample">
footnote = "Sample: Sample name;"
footnote = "Number of Reads: The total number of reads sequenced;"
footnote = "Valid Barcodes: Ratio of barcode in Reads to known data sets;"
footnote = "Q30 Bases in Barcode: The percentage of bases in Barcode with a mass value (Q=-10log(err rate)) greater than 30;"
footnote = "Q30 Bases in RNA Read: The percentage of bases in RNA Reads with a mass value (Q=-10log(err rate)) greater than 30;"
footnote = "Q30 Bases in UMI: The percentage of bases in UMI with a mass value (Q=-10log(err rate)) greater than 30."

@subtitle
number = 2
Genome Alignment
@paragraph
STAR\reference{3} was used to map clean reads to the reference genome, and the number of reads mapped to exon regions, intron regions and inter-genetic regions was counted. The statistical results are shown in Table3.
@table
number = 3
title = "Statistics of Clean Reads aligned to the reference genome"
file = <url = IDBiotech_result/Mapping.xls>
format = <field = 1; type = string; align =centre; desc = "Sample">
format = <field = 2; type = string; align =centre; desc = "Sample">
format = <field = 3; type = string; align =centre; desc = "Sample">
format = <field = 4; type = string; align =centre; desc = "Sample">
format = <field = 5; type = string; align =centre; desc = "Sample">
footnote = "Sample: Sample name;"
footnote = "Reads Mapped to Genome: The ratio of reads aligned to reference genome;"
footnote = "Reads Mapped to Exonic Regions: The ratio of reads aligned to exonic regions of reference genome;"
footnote ="Reads Mapped to Intronic Regions: The ratio of reads aligned to intronic regions of reference genome;"
footnote ="Reads Mapped to Intergenic Regions: The ratio of reads aligned to intergenic regions of reference genome."

@subtitle
number = 3
Quantification of Gene Expression
@paragraph
 Using STARsolo\reference{4} software, reads (Uniquely Mapping Reads) compared to the unique position of the reference genome were counted according to their corresponding relationship with genes and the amount of gene expression (UMI number) to obtain the gene capture situation of each cell. The detailed results were shown in 4.
@table
number = 4
title = "Statistics of Unique Mapping Reads aligned to the reference genome"
file = <url = IDBiotech_result/Cell.xls>
format = <field = 1; type = string; align =centre; desc = "Sample">
format = <field = 2; type = string; align =centre; desc = "Sample">
format = <field = 3; type = string; align =centre; desc = "Sample">
format = <field = 4; type = string; align =centre; desc = "Sample">

<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>BGI Project Report</title>
<style type="text/css">
.project_id {
        margin-left: 20px
        font-family: "Noto Sans CJK SC Medium","Source Han Sans CN Medium";
        font-size: 20px;
        display: block;
        width: 100%;
        text-align: left;
}

body {
	margin-left: 0px;
	margin-top: 30px;
	margin-right: 0px;
	margin-bottom: 30px;
	width:100%;
	position:absolute;
        text-align: center;
}
.cover{
        font-family:"Noto Sans CJK SC Medium","Source Han Sans CN Medium";
	font-size:36px;
        margin-top: 120px;
	display:block;
	width:100%;
	text-align:center;
}
.report_title{
        margin-top: 100px;
        font-size: 42px;
        font-family: "Noto Sans CJK SC Medium","Source Han Sans CN Medium";
}
</style>
</head>
<body>
    <div class="project_id">PROJECT_ID</div>
	<div class="cover">
		<div class="report_title">BGI Report</div>

  		<div><span id="date" style="80px;font-size:28px;color:#3b3e42;"><script type="text/javascript">
                        var today = new Date();
                        //document.write( dayName[today.getDay()]   +", " + today.getDate() + strDay    + " " + monName[today.getMonth()]+', '+ today.getFullYear());
            document.write(today.getFullYear()+"/"+(today.getMonth()+1)+"/"+today.getDate());
                </script></span>
        </div>
        <br/>
        <div style="margin-top:150px;"><img src=COVER.PNG width="90%"/></div>
        <div><br/></div>
        <div style="margin-top:20px;font-size:18px;font-family:Arial, Helvetica, sans-serif;color:#4b4b4b;">©<script type="text/javascript">var today1 = new Date();document.write(today1.getFullYear())</script> BGI All Rights Reserved</div>
	</div>
</body>
</html>
